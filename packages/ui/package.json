{
	"name": "@woofing/ui",
	"version": "0.1.0",
	"description": "woof.ing design system — tokens, themes, and accessible components on react-aria-components",
	"license": "MIT",
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tokens.css": "./dist/tokens.css",
		"./theme.css": "./dist/theme.css"
	},
	"scripts": {
		"build": "vite build --config vite.lib.config.ts && cp src/tokens.css src/theme.css dist/",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build"
	},
	"dependencies": {
		"cva": "1.0.0-beta.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-react-aria-components": "^2.2.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.5.5",
		"@storybook/react-vite": "^10.5.5",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"lucide-react": "^1.28.0",
		"react": "^19.2.8",
		"react-aria-components": "^1.20.0",
		"react-dom": "^19.2.8",
		"storybook": "^10.5.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.2.0",
		"vite-plugin-dts": "^5.0.3"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-aria-components": "^1.20.0",
		"react-dom": "^19.0.0"
	}
}
